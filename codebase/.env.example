# Copy this file to .env (gitignored) and fill in your own key(s).
# Never commit the real .env -- see 02-guide.md §3.4.

# Gemini via Google AI Studio -- guide-endorsed free tier (~1,500 req/day).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI -- only if the team uses it instead of/alongside Gemini.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which provider ai_decide/llm_factory.py uses: "gemini", "openai", or
# "anthropic". Only the matching *_API_KEY above (and, for anthropic,
# ANTHROPIC_API_KEY) needs to be set. bot_gateway.py/run_live.py/
# simulate_cron.py/build_demo_cache.py all default to "gemini" in code if
# this is left blank, since that's the key this project ships with.
LLM_PROVIDER=gemini

# Optional: override the specific model for whichever LLM_PROVIDER is
# active -- only the var matching LLM_PROVIDER above is read. IMPORTANT:
# comment a line out (don't leave it as e.g. "OPENAI_MODEL=" with no
# value) to actually fall back to ai_decide/llm_factory.py's own default --
# an empty value is still a value, so it would override the default with
# an empty model name and break that provider if ever selected.
# gemini-3.5-flash-lite is recommended over the plainer gemini-3.5-flash --
# the free tier's daily quota for gemini-3.5-flash is very low (~20
# req/day) and gets exhausted fast; flash-lite has separate, higher headroom.
GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Discord webhook for --send-to-discord -- target channel > Edit Channel >
# Integrations > Webhooks > New Webhook > Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# Discord BOT for run_live.py -- a separate app from the webhook above, needed
# because a webhook can only post, never read/fetch messages.
# 1. https://discord.com/developers/applications -> New Application
# 2. Bot tab -> Reset Token -> copy it here as DISCORD_BOT_TOKEN
# 3. Bot tab -> enable "Message Content Intent" (required, or content is empty)
# 4. OAuth2 -> URL Generator -> scopes "bot" + "applications.commands"
#    (the latter is required for bot_gateway.py's slash commands to
#    register at all), permissions "View Channel" + "Read Message History"
#    -> open the generated URL to invite it to the server
# 5. Enable Developer Mode (User Settings > Advanced), then right-click the
#    server icon / each target channel -> Copy Server ID / Copy Channel ID
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=

# /labcoach-check (bot_gateway.py) only -- how many hours a question must
# sit unanswered before it's flagged, for live demo purposes. Separate from
# the production 4h threshold (detect/rules.py's default, used by
# /labcoach-demo, run_live.py, simulate_cron.py, main.py) since a real
# unanswered question rarely sits for a full 4 real hours during a demo.
# Comment out to use the code default (0.5).
LIVE_MIN_HOURS_UNANSWERED=0.5
